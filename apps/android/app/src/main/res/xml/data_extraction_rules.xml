<?xml version="1.0" encoding="utf-8"?>
<!-- F-262 (A-352): the database, preferences and DataStore files never leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="budmon.db" />
        <exclude domain="database" path="budmon.db-shm" />
        <exclude domain="database" path="budmon.db-wal" />
        <exclude domain="database" path="budmon.db-journal" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="budmon.db" />
        <exclude domain="database" path="budmon.db-shm" />
        <exclude domain="database" path="budmon.db-wal" />
        <exclude domain="database" path="budmon.db-journal" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
