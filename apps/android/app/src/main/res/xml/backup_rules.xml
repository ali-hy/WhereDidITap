<?xml version="1.0" encoding="utf-8"?>
<!-- F-262 (A-352): Android 11 and older; the same six excludes as data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="database" path="budmon.db" />
    <exclude domain="database" path="budmon.db-shm" />
    <exclude domain="database" path="budmon.db-wal" />
    <exclude domain="database" path="budmon.db-journal" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
