    "@fastify/helmet": "13.1.1",
    "@fastify/otel": "0.21.1",
    "@fastify/rate-limit": "11.2.0",
    "@formatjs/intl": "6.1.2",
    "@google-cloud/kms": "6.2.1",
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
