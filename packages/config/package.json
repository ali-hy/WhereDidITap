{
  "name": "@budmon/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./prettier": {
      "types": "./prettier/index.d.ts",
      "default": "./prettier/index.js"
    },
    "./stylelint": {
      "types": "./stylelint/index.d.ts",
      "default": "./stylelint/index.js"
    },
    "./tsconfig/*.json": "./tsconfig/*.json"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-formatjs": "8.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "stylelint-use-logical": "2.1.3",
    "typescript-eslint": "8.71.0"
  },
  "peerDependencies": {
    "eslint": "10.12.0",
    "prettier": "^3.0.0",
    "typescript": "5.9.3",
    "stylelint": "17.16.0"
  },
  "devDependencies": {
    "stylelint": "17.16.0"
  }
}
