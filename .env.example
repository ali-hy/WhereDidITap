# Development configuration (F-10). `pnpm dev` copies this file to `.env` when `.env` is missing.
# Every variable the server reads is listed; an empty value means "not set".
# Variables ending in _FILE name a file whose content is the value.

# --- all processes ---
APP_ENV=development
LOG_LEVEL=debug
BUDMON_RELEASE=dev
DB_HOST=localhost
DB_NAME=budmon
DB_USER=budmon_app
DB_PORT=5432
DB_PASSWORD_FILE=.data/dev-secrets/db_password
DB_PASSWORD_PREVIOUS_FILE=
DB_SSLMODE=disable
DB_SSL_ROOT_CERT_FILE=
DB_POOL_MAX=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTLP_HEADERS_FILE=
SENTRY_DSN=

# --- migrate and development tools ---
ROLE_SECRETS_FILE=.data/dev-secrets/roles.json
DEV_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- worker ---
WORKER_ROLES=capture,general
QUEUE_DB_USER=budmon_queue
QUEUE_DB_PASSWORD_FILE=.data/dev-secrets/queue_password
QUEUE_POOL_MAX=
# Absolute path of the worker heartbeat (default /tmp/heartbeat; tests only).
HEARTBEAT_FILE=

# --- api ---
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
TRUSTED_PROXY=
CLIENT_MIN_ANDROID=0
CLIENT_LATEST_ANDROID=0
CLIENT_MIN_WEB=0
ANDROID_DOWNLOAD_URL=
CURSOR_KEY_FILE=.data/dev-secrets/cursor_key
RATE_LIMIT_HMAC_KEY_FILE=.data/dev-secrets/rate_limit_key
API_SECRETS_KEYS_FILE=.data/dev-secrets/api_secrets.json
DEV_OBJECTS_SIGNING_KEY_FILE=.data/dev-secrets/dev_objects_key
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET_FILE=
GOOGLE_SIGNIN_ANDROID_CLIENT_IDS=
GOOGLE_SIGNIN_CALLBACK_ORIGIN=http://localhost:5173
GOOGLE_SIGNIN_APP_ORIGINS=http://localhost:5173
RECOVERY_CODE_HMAC_KEYS_FILE=.data/dev-secrets/recovery_keys.json

# --- api and workers ---
CAPTURE_PUBLIC_KEY_FILE=.data/dev-secrets/capture_public.pem
CAPTURE_KEY_VERSION=local:1
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_REDIRECT_ORIGIN=http://localhost:5173
OBJECT_STORE_KIND=fs
OBJECT_STORE_FS_ROOT=.data/objects
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_EXPORTS=
S3_BUCKET_ERASURE_LOG=
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY_FILE=

# --- worker with the capture role ---
KMS_PROVIDER=local
GCP_CREDENTIALS_FILE=
CAPTURE_PRIVATE_KEY_FILE=.data/dev-secrets/capture_private.pem
MAILBOX_HMAC_KEY_FILE=.data/dev-secrets/mailbox_key

# --- worker with the general role ---
FX_PROVIDER=fixed
FX_PRIMARY_APP_ID_FILE=
FX_PRIMARY_BASE_URL=
FX_FALLBACK_BASE_URL=
FX_FALLBACK_MIRROR_URL=
SMTP_URL=smtp://localhost:1025
SMTP_PASSWORD_FILE=
EMAIL_FROM=Budmon <no-reply@budmon.local>
